PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com

# Authentication & Security
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
PEPPER_KEY=replace_with_secure_random_pepper_kept_in_aws_secrets_manager
AES_ENCRYPTION_KEY=replace_with_64_hex_character_key_for_aes_256_gcm
MFA_ISSUER="School Management System"
ADMIN_SETUP_SECRET=replace_with_bootstrap_secret_for_initial_admin

# Email Verification
EMAIL_SERVICE_MODE=smtp
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=aws_ses_smtp_user
SMTP_PASS=aws_ses_smtp_password
SMTP_FROM="School Administration" <noreply@school.edu>

# AWS S3 Backups & Cloud Configuration
AWS_REGION=us-east-1
AWS_S3_BACKUP_BUCKET=school-management-backups-production
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS=30
