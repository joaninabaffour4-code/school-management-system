{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/verify-email",
      "destination": "/verify-email.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/teacher/dashboard",
      "destination": "/teacher-dashboard.html"
    },
    {
      "source": "/student/dashboard",
      "destination": "/student-dashboard.html"
    },
    {
      "source": "/parent/dashboard",
      "destination": "/parent-dashboard.html"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
